# ============================================================
# Wedding Memories - Ortam Degiskenleri
# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun:
#   cp .env.example .env
# .env dosyasini ASLA git'e commit etmeyin.
# ============================================================

# Uygulama ortami: development | production
APP_ENV=production

# Veritabani. SQLite varsayilan; PostgreSQL'e gecis icin
# postgresql+psycopg://user:pass@host:5432/wedding yazilabilir.
DATABASE_URL=sqlite:////app/data/db/wedding.sqlite3

# Upload kok dizini (container ici).
# Pi uzerinde docker-compose bu yola /mnt/usb/wedding-uploads baglar.
UPLOAD_ROOT=/app/data/uploads

# Host tarafindaki upload klasoru (docker-compose bind mount icin).
# Pi uzerinde USB disk yolu. Kurulum: scripts/setup_storage.sh
UPLOAD_ROOT_HOST=/mnt/usb/wedding-uploads

# Maksimum dosya boyutu (MB). Dugun videolari buyuktur; 2048 = 2GB.
MAX_UPLOAD_SIZE_MB=2048

# ---- Admin hesabi ----
# Sifreyi DUZ METIN olarak buraya yazmayin!
# Once:  python scripts/generate_admin_hash.py
# Cikan degeri ADMIN_PASSWORD_HASH'e yapistirin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ---- Guvenlik ----
# Rastgele uzun bir metin: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=CHANGE_ME_RANDOM_LONG_SECRET

# QR kodun isaret edecegi genel URL.
# Lokal kullanim: http://192.168.x.x  (Raspberry Pi IP'niz)
# Domain baglandiginda: https://site.com
PUBLIC_URL=

# HTTPS calisirken true yapin (cookie'lerin Secure flag'i icin).
COOKIE_SECURE=false

# Pi uzerinde true olmali: USB mount edilmediyse upload'leri engeller.
# Gelistirmede (klasor local diskte) false birakilabilir.
REQUIRE_STORAGE_MARKER=true

# ---- Rate limitler ----
# 15 dakikada kac hatali admin giris denemesi
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
# Saatte IP basina maksimum yuklenen dosya sayisi
UPLOAD_MAX_PER_HOUR=120

# ---- Docker ----
# Uygulamanin yayinlanacagi host portu
APP_PORT=80
